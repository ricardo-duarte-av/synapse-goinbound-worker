# Route inbound federation transactions to goinbound-worker.
#
# goinbound-worker answers EDU-only transactions itself and proxies everything
# else to the Python inbound worker, so it REPLACES the existing /send
# location's upstream rather than sitting beside it. The Python worker stays
# up: it is goinbound-worker's upstream.

upstream av-goinbound-worker {
    server unix:/var/sockets/nginx/av-goinbound-worker-1.sock max_fails=0;
    keepalive 8;
}

# In the server { } block, in place of the current
# `location ~ ^/_matrix/federation/v1/send/` block:
#
#   location ~ ^/_matrix/federation/(v1|v2)/send/ {
#       include /data/nginx/custom/matrix-config.conf;
#
#       proxy_pass http://av-goinbound-worker;
#
#       # Do not let nginx rewrite the URI: the X-Matrix signature covers
#       # it. proxy_pass with no URI component passes it through unchanged.
#       proxy_http_version 1.1;
#       proxy_set_header Connection "";
#
#       # A transaction with PDUs whose missing events must be fetched can
#       # take minutes in Synapse; goinbound-worker waits up to its
#       # upstream.timeout_seconds for it.
#       proxy_read_timeout 200s;
#
#       access_log /dev/null;
#   }
#
# Rollback is pointing this location back at av-inbound-federation-workers-ih.
